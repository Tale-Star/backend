APP_NAME=Tale Star API
APP_ENV=local
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/talestar.db
ASSETS_DIRECTORY=./data/assets
MEDIA_DIRECTORY=./data/media
GPU_QUEUE_LOCK_PATH=./data/gpu-queue.lock
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SQLITE_BUSY_TIMEOUT_MS=5000
JWT_SECRET_KEY=development-only-change-this-jwt-secret-before-deployment-32chars
JWT_ACCESS_TOKEN_MINUTES=30

# Local adapters are the default; model libraries are imported only by the worker.
IMAGE_GENERATOR=fake
MUSIC_GENERATOR=fake
MODEL_CACHE_DIRECTORY=./data/model-cache
MODEL_DOWNLOADS_ENABLED=false

# Z-Image-Turbo (Diffusers). Point MODEL_CACHE_DIRECTORY outside Git for weights/cache.
ZIMAGE_MODEL_PATH=Tongyi-MAI/Z-Image-Turbo
ZIMAGE_DEVICE=auto
ZIMAGE_DTYPE=auto
ZIMAGE_CPU_OFFLOAD=true
ZIMAGE_WIDTH=1024
ZIMAGE_HEIGHT=1024
ZIMAGE_INFERENCE_STEPS=8
# Optional JSON mapping of Tale Star StyleProfile names to prompt/LoRA configuration.
# ZIMAGE_STYLE_PROFILES_FILE=./data/style-profiles.json

# ACE-Step 1.5 source install and checkpoints must live outside this repository.
# ACESTEP_PROJECT_ROOT=D:/models/ACE-Step-1.5
ACESTEP_MODEL_CONFIG=acestep-v15-turbo
ACESTEP_DEVICE=auto
ACESTEP_OFFLOAD_TO_CPU=true
ACESTEP_OFFLOAD_DIT_TO_CPU=true
ACESTEP_QUANTIZATION=none
